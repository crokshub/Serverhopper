local function fmtT(s)
    local m = math.floor(s / 60)
    local sec = math.floor(s % 60)
    if m > 0 then return m .. "m " .. sec .. "s" end
    return sec .. "s"
end

local function pingAtual()
    local ok, p = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and p then return math.floor(p) end
    return 0
end

local function tp(sv)
    if not sv then return end
    table.insert(Hist, 1, { id = sv.id, playing = sv.playing, maxPlayers = sv.maxPlayers })
    while #Hist > 15 do table.remove(Hist) end
    pcall(function()
        TS:TeleportToPlaceInstance(game.PlaceId, sv.id, PL.LocalPlayer)
    end)
end

